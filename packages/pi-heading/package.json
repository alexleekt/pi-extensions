{
    "name": "@alexleekt/pi-heading",
    "version": "0.3.1",
    "description": "Know where you are at a glance. One-line session heading widget for the Pi agent.",
    "type": "module",
    "main": "index.ts",
    "scripts": {
        "typecheck": "tsc --noEmit",
        "check": "tsc --noEmit && bun test",
        "test": "bun test",
        "pack-smoke": "node tools/pack-smoke.mjs"
    },
    "pi": {
        "extensions": [
            "./index.ts"
        ]
    },
    "dependencies": {
        "@alexleekt/pi-shared": "^0.1.0"
    },
    "peerDependencies": {
        "@earendil-works/pi-ai": ">=0.80.0",
        "@earendil-works/pi-coding-agent": ">=0.81.0",
        "@earendil-works/pi-tui": "*",
        "typebox": ">=1.1.0"
    },
    "files": [
        "index.ts",
        "types.ts",
        "handlers",
        "state",
        "ui",
        "util",
        "llm",
        "prompts",
        "tools",
        "!**/*.test.ts",
        "README.md",
        "CHANGELOG.md",
        "LICENSE"
    ],
    "keywords": [
        "pi-package",
        "pi-extension",
        "pi",
        "heading",
        "session-summary"
    ],
    "license": "MIT",
    "author": "Alex Lee",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/alexleekt/pi-extensions.git"
    },
    "homepage": "https://github.com/alexleekt/pi-extensions/tree/main/packages/pi-heading#readme",
    "bugs": {
        "url": "https://github.com/alexleekt/pi-extensions/issues"
    }
}
